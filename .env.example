# HIMGAURAV v8.0 — server-side integration settings
# Copy this file to .env and fill ONLY services you actually use.
# Core multilingual alert templates, CAP export, browser notification and local siren do not need API keys.
# NEVER put private keys/tokens in config.js or index.html.

# Optional: private ThingSpeak channel. Public channels need no read key.
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_KEY=

# Optional: read-only NDMA SACHET CAP reference supplied for legitimate consumption.
# Do not guess/scrape identifiers.
SACHET_CAP_IDENTIFIER=
SACHET_CAP_FEED_URL=

# Optional: controlled agency/test workflow endpoint that YOU operate or are authorised to use.
# HIMGAURAV sends a DRAFT package only. This is NOT an NDMA/SACHET credential.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Optional: local Node-RED / ESP32 gateway / siren controller webhook you operate.
# The UI sends an explicitly test-labelled packet.
LOCAL_GATEWAY_WEBHOOK_URL=
LOCAL_GATEWAY_WEBHOOK_TOKEN=

# Optional port override.
PORT=8818

# NASA Earthdata bearer token for authenticated ASF HyP3 processing.
# Create/manage the token in Earthdata Login; keep it server-side only.
EARTHDATA_TOKEN=

# Safety guard for scheduler/automation helper. Default OFF.
# Even when enabled, browser automation cycles require explicit confirmation before submission.
ASF_AUTO_SUBMIT=0
