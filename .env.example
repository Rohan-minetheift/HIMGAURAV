# HIMGAURAV v7.0 — server-side integration settings
# Copy this file to .env and fill ONLY services you actually use.
# NEVER commit .env or real credentials.

# Optional: private ThingSpeak channel. Public channels need no read key.
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_KEY=

# Optional: read-only NDMA SACHET reference supplied for legitimate consumption.
SACHET_CAP_IDENTIFIER=
SACHET_CAP_FEED_URL=

# Optional: controlled agency/test workflow endpoint that YOU operate or are authorised to use.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Optional: local Node-RED / ESP32 gateway / siren controller webhook you operate.
LOCAL_GATEWAY_WEBHOOK_URL=
LOCAL_GATEWAY_WEBHOOK_TOKEN=

# Optional local server port.
PORT=8807
